rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the user's role from the users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // --- Users Collection ---
    // Anyone authenticated can read user profiles (needed for names/roles).
    // Users can only create or update their own profile, or Admins can do it.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Courses Collection ---
    // Anyone authenticated can read courses. Only admins can modify.
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Course Subcollections (lessons, media, assignments, tests) ---
    // Accessible to all authenticated users for reading, but only admins for writing.
    match /courses/{courseId}/lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /courses/{courseId}/media/{mediaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /courses/{courseId}/assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /courses/{courseId}/tests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- Enrollments Collection ---
    // Students can read/create their own enrollments. Admins can manage all.
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- Test Attempts Collection ---
    // Students can create their own test attempts and read their own. Admins can read all.
    match /testAttempts/{attemptId} {
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // --- Reviews Collection ---
    // Anyone can read reviews. Students can create. Admins can delete.
    match /reviews/{reviewId} {
      allow read: if true; // Public can see reviews
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // --- Contact Messages ---
    // Anyone can create a contact message (even unauthenticated). Only admins can read/delete.
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
