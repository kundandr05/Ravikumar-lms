rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // PDF Notes path: Only admins can upload/delete. Any authenticated user can read.
    match /notes/{courseId}/{fileName} {
      allow read: if isAuthenticated();
      allow write, delete: if isAdmin();
    }
    
    // Course Thumbnails: Admins can upload, anyone can read.
    match /thumbnails/{fileName} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
