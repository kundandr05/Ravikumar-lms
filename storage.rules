rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin (note: Storage rules can't query Firestore directly,
    // so it's best to set Custom Claims for admin roles. For this LMS, we allow
    // authenticated users to read everything, and we'll allow authenticated users 
    // to upload. In a production app, use Custom Claims for perfect security).
    
    match /{allPaths=**} {
      allow read: if true; // Allow anyone to read images/pdfs
      allow write: if isAuthenticated(); // Allow logged in admins to upload
    }
  }
}
